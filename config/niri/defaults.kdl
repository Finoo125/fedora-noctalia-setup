// fedora-noctalia-setup defaults for niri. Included by ~/.config/niri/config.kdl, which comes after this file, so what
// you set there wins (binds override by key, most sections merge). Check with `niri validate`.
// Reference: https://github.com/YaLTeR/niri/wiki/Configuration:-Introduction

input {
    keyboard {
        numlock
    }
    touchpad {
        tap
        natural-scroll
    }
    mouse {
        natural-scroll
    }
    focus-follows-mouse max-scroll-amount="0%"
}

cursor {
    xcursor-theme "Classic-pointer"
    xcursor-size 32
}

environment {
    // Qt and KDE apps read Noctalia's colors, Breeze, Papirus and the fonts from kdeglobals (plasma-integration).
    QT_QPA_PLATFORMTHEME "kde"
    // KDE apps find the app menu (Dolphin's "Open with") in Plasma's menu file, outside Plasma too.
    XDG_MENU_PREFIX "plasma-"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    TERMINAL "xdg-terminal-exec"
}

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

layout {
    gaps 10
    center-focused-column "never"
    default-column-width { proportion 0.5; }
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    // The ring's colors come from Noctalia's niri template (noctalia.kdl).
    focus-ring {
        width 2
    }
}

// Noctalia: the shell (bar, launcher, notifications, lock screen). X11 apps start xwayland-satellite on their own.
spawn-at-startup "noctalia"
// Mounts USB drives as they are plugged in; Noctalia's udiskie plugin shows the notifications.
spawn-at-startup "udiskie" "--no-notify" "--no-tray"

window-rule {
    geometry-corner-radius 14
    clip-to-geometry true
}

window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

window-rule {
    match app-id="^(org.kde.kcalc|nm-connection-editor|system-config-printer)$"
    open-floating true
}

// Noctalia's panels animate themselves; its wallpaper sits in the overview's backdrop.
layer-rule {
    match namespace="^noctalia-wallpaper"
    place-within-backdrop true
}

// The standard keybindings come from ~/.config/niri/keybinds.kdl (written from config/keybinds.tsv and your changes;
// see `keybinds`). These are niri's own extras.
binds {
    Mod+R { switch-preset-column-width; }
    Mod+Shift+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}

include optional=true "~/.config/niri/keybinds.kdl"
